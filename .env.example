# Archivo de Ejemplo de Variables de Entorno - Vionest Chatbot
# Copiar este archivo a server/.env antes de iniciar la aplicación

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Conexión local a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=vionest

# Seguridad JWT (Generar una cadena aleatoria segura en producción)
JWT_SECRET=tu_secreto_jwt_de_al_menos_32_caracteres_aleatorios
JWT_EXPIRES_IN=24h

# Usuario Administrador Inicial de Prueba para Desarrollo Local
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=123

# Google Gemini API (Google AI Studio)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
