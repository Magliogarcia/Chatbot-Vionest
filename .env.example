# Archivo de Ejemplo de Variables de Entorno - Vionest Chatbot
# Copiar este archivo a server/.env antes de iniciar la aplicación

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Conexión a MongoDB (Local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=vionest

# Seguridad JWT
JWT_SECRET=tu_secreto_jwt_de_al_menos_32_caracteres_aleatorios
JWT_EXPIRES_IN=24h

# Usuario Administrador Inicial
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=123

# OpenRouter API (Cascada de 5 Agentes de IA Gratuitos, 20s c/u)
OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,recursive/flint-v1.0:free,cohere/north-mini-code:free
OPENROUTER_TIMEOUT_MS=20000

# Google Gemini API (Respaldo Final con rotación automática)
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=25000
